<?xml version="1.0" encoding="utf-8"?>
<!-- The artifact configuration for the IDISMAM project in SignPath.
     Paste it into the project's artifact configuration there; SignPath
     reads it from its own settings, not from this file.
     The signing request is a zip of IDISMAM-<version>-windows-amd64.exe
     and mcpackctl-<version>-windows-amd64.exe; both are signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="IDISMAM-*-windows-amd64.exe" min-matches="1" max-matches="1"/>
      <include path="mcpackctl-*-windows-amd64.exe" min-matches="1" max-matches="1"/>
      <for-each>
        <authenticode-sign/>
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
